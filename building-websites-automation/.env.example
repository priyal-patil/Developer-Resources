# Contentstack test account (use a DEDICATED / throwaway org, not your real one)
CONTENTSTACK_EMAIL=
CONTENTSTACK_PASSWORD=
CONTENTSTACK_ORG_ID=
CONTENTSTACK_REGION=AWS-EU

# Where cloned kickstart repos are checked out and run during a test run
WORKDIR=./workdir

# Set true to drive the dashboard steps (token creation, Live Preview) in a browser.
# Set false to pause and let a human do the dashboard clicks, then resume.
AUTOMATE_DASHBOARD=true
