# Contentstack test account (same shared QA org as the sibling automations)
CONTENTSTACK_EMAIL=
CONTENTSTACK_PASSWORD=
CONTENTSTACK_ORG_ID=
CONTENTSTACK_REGION=AWS-NA

# Filled in by `npm run seed` the first time it creates/finds the dedicated
# sdk-automation stack — persisted here so later runs reuse the same stack
# instead of reseeding (these snippets are read-heavy, not disposable).
STACK_API_KEY=
DELIVERY_TOKEN=
ENVIRONMENT=production
SEED_ASSET_UID=
SEED_ENTRY_UID=
SEED_GLOBAL_FIELD_UID=
