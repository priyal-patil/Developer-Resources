{
  "name": "cli-automation",
  "version": "0.1.0",
  "description": "Reads each Contentstack CLI doc, runs every command and example verbatim against a seeded QA stack, audits the doc's Options table against --help, and reports every gap",
  "type": "module",
  "scripts": {
    "parse": "tsx src/parse/parseDoc.ts",
    "run-one": "tsx src/index.ts",
    "report": "tsx src/report/generateReport.ts",
    "teardown": "tsx src/setup/teardown.ts",
    "sweep": "tsx src/setup/teardown.ts sweep",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  }
}
