{
  "name": "kickstart-automation",
  "version": "0.1.0",
  "description": "Reads each Contentstack Kickstart doc, performs the steps, verifies they work, and flags missing or broken steps",
  "type": "module",
  "scripts": {
    "parse": "tsx src/parse/parseDoc.ts",
    "run-one": "tsx src/index.ts",
    "run-all": "tsx src/index.ts --all",
    "report": "tsx src/report/generateReport.ts",
    "teardown": "tsx src/api/contentstack.ts delete",
    "sweep": "tsx src/api/contentstack.ts sweep",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  }
}
